│   40                 headers, body = message.split("\r\n\r\n", 1)                   │
│   41             elif "\n\n" in message:                                            │
│   42                 headers, body = message.split("\n\n", 1)                       │
│   43             else:                                                              │
│   44                 headers, body = "", message                                    │
│   45                                                                                │
│   46             subject = ""                                                       │
│   47             for line in headers.splitlines():                                  │
