│    7                                                                                │
│    8                                                                                │
│    9 def _axiom_smtp_apprise_wrapper(host: str = "localhost", port: int = 25):      │
│   10     """Bridge smtplib.SMTP's sendmail-based API to apprise's notify-based API. │
│   11                                                                                │
│   12     smtplib.SMTP(host, port).sendmail(sender, recipients, message) sends a raw │
│   13     RFC822-style message string and returns a dict of failed recipients (or    │
│   14     raises on error). apprise.Apprise().notify(...) instead takes a            │
│   15     already-decomposed title/body pair and returns a bool indicating success,  │
│   16     after being configured with a service URL (e.g. mailto://...) via          │
│   17     apobj.add(...).                                                            │
│   18                                                                                │
│   19     This wrapper returns a small facade object exposing a sendmail(sender,     │
│   20     recipients, message) method with the same signature callers already use.   │
│   21     Internally it builds an apprise.Apprise() instance pointed at a            │
│   22     mailto:// URL derived from host/port/sender/recipients, splits the         │
│   23     RFC822-style message into a subject (from the "Subject:" header) and a     │
│   24     body (the text after the blank line separating headers from body, or the   │
│   25     whole message if no such separator is found), and calls notify() with      │
│   26     those instead of performing a real SMTP conversation. This lets existing   │
│   27     call sites keep calling sendmail(...) unmodified while the notification    │
│   28     is actually delivered through apprise.                                     │
│   29     """                                                                        │
│   30     import apprise  # lazy import, mirrors the lazy smtplib import for testabi │
│   31                                                                                │
│   32     class _AppriseSMTPFacade:                                                  │
│   33         def sendmail(self, sender, recipients, message):                       │
│   34             apobj = apprise.Apprise()                                          │
│   35             to = ",".join(recipients)                                          │
