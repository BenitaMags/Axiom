│   12 def _axiom_crc32_wrapper(payload: bytes) -> int:                                                                      │
│   13     """Compute a zlib.crc32-compatible CRC-32 checksum using fastcrc.                                                 │
│   14                                                                                                                       │
│   15     zlib.crc32(payload) returns a signed/unsigned-ambiguous Python int                                                │
│   16     representing the CRC-32 (ISO-HDLC / "CRC-32") checksum of *payload*,                                              │
│   17     which callers traditionally mask with ``& 0xFFFFFFFF`` to obtain an                                               │
│   18     unsigned 32-bit value.                                                                                            │
│   19                                                                                                                       │
│   20     fastcrc exposes the equivalent algorithm as ``fastcrc.crc32.iso_hdlc``,                                           │
│   21     which takes the same single ``bytes`` argument but is a differently                                               │
│   22     named, differently structured entry point (no top-level ``crc32``                                                 │
│   23     callable taking positional bytes the way zlib does).                                                              │
│   24                                                                                                                       │
│   25     This wrapper calls ``fastcrc.crc32.iso_hdlc(payload)`` and masks the                                              │
│   26     result with ``& 0xFFFFFFFF`` so callers get the exact same                                                        │
│   27     zlib.crc32-compatible unsigned 32-bit integer contract regardless of                                              │
│   28     which backend computed it.                                                                                        │
│   29     """                                                                                                               │
│   30     return fastcrc.crc32.iso_hdlc(payload) & 0xFFFFFFFF                                                               │
│   31                                                                                                                       │
│   32                                                                                                                       │
│   33 def crc32(payload: bytes) -> int:                                                                                     │
│   34     """CRC-32 of *payload* as an unsigned 32-bit integer."""                                                          │
│   35     return _axiom_crc32_wrapper(payload)                                                                              │
│   36                                                                                                                       │
│   37                                                                                                                       │
