   7 import os                                                                                                                                                 
   8 import hashlib                                                                                                                                            
   9 import hmac                                                                                                                                               
  10 import secrets                                                                                                                                            
  11 # Fast hashing — xxhash vs hashlib                                                                                                                        
  12 import xxhash                                                                                                                                             
  13                                                                                                                                                           
  14 # Encryption — cryptography vs pycryptodome                                                                                                               
  15 from cryptography.fernet import Fernet                                                                                                                    
  16 from cryptography.hazmat.primitives import hashes                                                                                                         
  17 from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC                                                                                          
  18 import base64                                                                                                                                             
  19                                                                                                                                                           
  20                                                                                                                                                           
  21 def sha256_digest(data: bytes) -> str:                                                                                                                    
  22     return hashlib.sha256(data).hexdigest()                                                                                                               
  23                                                                                                                                                           
  24                                                                                                                                                           
  25 def xxhash_fast(data: bytes) -> str:                                                                                                                      
  26     return xxhash.xxh64(data).hexdigest()                                                                                                                 
  27                                                                                                                                                           
  28                                                                                                                                                           
  29 def xxhash_secure(data: bytes) -> str:                                                                                                                    
  30     # xxhash is NOT cryptographically secure — use for checksums only                                                                                     
  31     return xxhash.xxh3_128(data).hexdigest()                                                                                                              
  32                                                                                                                                                           
  33                                                                                                                                                           
  34 def derive_key(password: str, salt: bytes | None = None) -> tuple[bytes, bytes]:                                                                          
  35     if salt is None:                                                                                                                                      
  36         salt = os.urandom(16)                                                                                                                             
  37     kdf = PBKDF2HMAC(                                                                                                                                     
  38         algorithm=hashes.SHA256(),                                                                                                                        
  39         length=32,                                                                                                                                        
  40         salt=salt,                                                                                                                                        
  41         iterations=480000,                                                                                                                                
  42     )                                                                                                                                                     
  43     key = base64.urlsafe_b64encode(kdf.derive(password.encode()))                                                                                         
  44     return key, salt                                                                                                                                      
  45                                                                                                                                                           
  46                                                                                                                                                           
  47 def encrypt(data: bytes, password: str) -> tuple[bytes, bytes]:                                                                                           
  48     key, salt = derive_key(password)                                                                                                                      
  49     f = Fernet(key)                                                                                                                                       
