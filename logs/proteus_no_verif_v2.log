│    4 substitution target: `zlib.crc32` (stdlib) -> `fastcrc` (drop-in, faster).                                                                             │
│    5 """                                                                                                                                                    │
│    6 import struct                                                                                                                                          │
│    7 import fastcrc                                                                                                                                         │
│    8                                                                                                                                                        │
│    9 CRC_LEN = 4                                                                                                                                            │
│   10                                                                                                                                                        │
│   11                                                                                                                                                        │
│   12 def _axiom_crc32_wrapper(payload: bytes) -> int:                                                                                                       │
│   13     """Compute an unsigned 32-bit CRC-32 checksum of *payload*.                                                                                        │
│   14                                                                                                                                                        │
│   15     zlib.crc32 returns a plain Python int representing the unsigned 32-bit                                                                             │
│   16     CRC-32/ISO-HDLC checksum of the data. fastcrc.crc32.iso_hdlc computes the                                                                          │
│   17     same standard CRC-32 variant (same polynomial, init value, and xorout as                                                                           │
│   18     zlib.crc32), but may return a different numeric type (e.g. a numpy                                                                                 │
│   19     integer) that is not guaranteed to behave identically to a plain int in                                                                            │
│   20     downstream code, and does not guarantee the result is masked to 32 bits.                                                                           │
│   21     This wrapper casts the result to a plain Python int and masks it with                                                                              │
│   22     0xFFFFFFFF to guarantee an unsigned 32-bit value identical in type and                                                                             │
│   23     range to what zlib.crc32 would have produced.                                                                                                      │
│   24     """                                                                                                                                                │
│   25     return int(fastcrc.crc32.iso_hdlc(payload)) & 0xFFFFFFFF                                                                                           │
│   26                                                                                                                                                        │
│   27                                                                                                                                                        │
│   28 def crc32(payload: bytes) -> int:                                                                                                                      │
│   29     """CRC-32 of *payload* as an unsigned 32-bit integer."""                                                                                           │
│   30     return _axiom_crc32_wrapper(payload) & 0xFFFFFFFF                                                                                                  │
│   31                                                                                                                                                        │
│   32                                                                                                                                                        │
