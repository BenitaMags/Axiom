│    12     unit=...) and write_register(address, value, unit=...), each of which                                                                             │
│    13     returns a response object with an .isError() method and, for reads, a                                                                             │
│    14     .registers list of the values read.                                                                                                               │
│    15                                                                                                                                                       │
│    16     modbus-tk instead exposes a modbus_tcp.TcpMaster object. Connecting is                                                                            │
│    17     done via TcpMaster.open(), and both reads and writes are issued through a                                                                         │
│    18     single execute() method that takes a slave id and a Modbus function code                                                                          │
│    19     (from modbus_tk.defines) and either returns the raw tuple of register                                                                             │
│    20     values (for a read) or raises an exception (e.g.                                                                                                  │
│    21     modbus_tk.exceptions.ModbusError or a socket error) if the request                                                                                │
│    22     fails -- there is no response object with .isError().                                                                                             │
│    23                                                                                                                                                       │
│    24     This wrapper bridges that gap: it opens a TcpMaster and returns a small                                                                           │
│    25     adapter object whose connect()/read_holding_registers()/write_register()                                                                          │
│    26     methods call TcpMaster.execute() with the appropriate function code,                                                                              │
│    27     catch any exception raised by modbus-tk, and translate the outcome into                                                                           │
│    28     a lightweight response object exposing .isError() and .registers -- the                                                                           │
│    29     same shape _read1() and write_valve() already expect -- so their                                                                                  │
│    30     existing isError()-based error handling keeps working unchanged.                                                                                  │
│    31     """                                                                                                                                               │
│    32     import modbus_tk.defines as cst                                                                                                                   │
│    33     from modbus_tk.modbus_tcp import TcpMaster                                                                                                        │
│    34                                                                                                                                                       │
│    35     class _Response:                                                                                                                                  │
│    36         def __init__(self, registers=None, error=False):                                                                                              │
│    37             self.registers = registers                                                                                                                │
│    38             self._error = error                                                                                                                       │
│    39                                                                                                                                                       │
│    40         def isError(self):                                                                                                                            │
│    41             return self._error                                                                                                                        │
│    42                                                                                                                                                       │
│    43     class _Adapter:                                                                                                                                   │
│    44         def __init__(self, host, port):                                                                                                               │
│    45             self._master = TcpMaster(host=host, port=port)                                                                                            │
│    46             self._master.set_timeout(5.0)                                                                                                             │
│    47                                                                                                                                                       │
│    48         def connect(self):                                                                                                                            │
│    49             try:                                                                                                                                      │
│    50                 self._master.open()                                                                                                                   │
│    51                 return True                                                                                                                           │
│    52             except Exception:                                                                                                                         │
│    53                 return False                                                                                                                          │
│    54                                                                                                                                                       │
│    55         def read_holding_registers(self, address, count, unit=None):                                                                                  │
│    56             slave = unit if unit is not None else 1                                                                                                   │
│    57             try:                                                                                                                                      │
│    58                 result = self._master.execute(                                                                                                        │
│    59                     slave, cst.READ_HOLDING_REGISTERS, address, count                                                                                 │
│    60                 )                                                                                                                                     │
│    61                 return _Response(registers=list(result), error=False)                                                                                 │
│    62             except Exception:                                                                                                                         │
│    63                 return _Response(registers=None, error=True)                                                                                          │
│    64                                                                                                                                                       │
│    65         def write_register(self, address, value, unit=None):                                                                                          │
│    66             slave = unit if unit is not None else 1                                                                                                   │
│    67             try:                                                                                                                                      │
│    68                 self._master.execute(                                                                                                                 │
│    69                     slave,                                                                                                                            │
│    70                     cst.WRITE_SINGLE_REGISTER,                                                                                                        │
│    71                     address,                                                                                                                          │
│    72                     output_value=value,                                                                                                               │
│    73                 )                                                                                                                                     │
│    74                 return _Response(registers=None, error=False)                                                                                         │
│    75             except Exception:                                                                                                                         │
│    76                 return _Response(registers=None, error=True)                                                                                          │
│    77                                                                                                                                                       │
│    78     return _Adapter(host, port)                                                                                                                       │
│    79                                                                                                                                                       │
│    80                                                                                                                                                       │
│    81 def _default_client(host: str, port: int = 502):                                                                                                      │
│    82                                                                                                                                                       │
