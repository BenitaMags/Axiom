│   34     """Return *payload* with a big-endian CRC-32 trailer appended."""                                                                                  │
│   35     return payload + struct.pack(">I", crc32(payload))                                                                                                 │
│   36                                                                                                                                                        │
│   37                                                                                                                                                        │
│   38 def verify_frame(frame: bytes) -> bool:                                                                                                                │
│   39     """True iff *frame*'s trailing CRC-32 matches its payload."""                                                                                      │
│   40     if len(frame) < CRC_LEN:                                                                                                                           │
│   41         return False                                                                                                                                   │
