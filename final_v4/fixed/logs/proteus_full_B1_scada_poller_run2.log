│    26         super().__init__(message)                                                                                                                     │
│    27         self.response = response                                                                                                                      │
│    28                                                                                                                                                       │
│    29                                                                                                                                                       │
│    30 class ScadaConnectionError(OSError):                                                                                                                  │
