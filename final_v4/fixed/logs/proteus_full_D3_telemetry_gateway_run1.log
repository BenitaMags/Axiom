│     4 -> `aiomqtt` (async, context-managed) -> glue required. The client is injected.                                                                       │
│     5 """                                                                                                                                                   │
│     6 import json                                                                                                                                           │
│     7 import asyncio                                                                                                                                        │
│     8 import threading                                                                                                                                      │
│     9                                                                                                                                                       │
│    10                                                                                                                                                       │
│    11 def _amqtt_sync_bridge_client(host: str = "localhost", port: int = 1883):                                                                             │
│    12     """Build a synchronous facade over amqtt's async MQTTClient.                                                                                      │
│    13                                                                                                                                                       │
│    14     paho-mqtt's Client.connect()/Client.publish() are synchronous and                                                                                 │
│    15     Client.publish() hands back a MQTTMessageInfo whose ``.rc`` is 0 on                                                                               │
│    16     success and nonzero on failure. amqtt.client.MQTTClient is asyncio-only:                                                                          │
│    17     ``connect()`` is a coroutine that returns the CONNACK return code                                                                                 │
│    18     (0 == accepted, nonzero == rejected by the broker) and ``publish()`` is a                                                                         │
│    19     coroutine that returns ``None`` -- amqtt gives no delivery confirmation                                                                           │
│    20     at QoS 0 (same as paho at QoS 0) and instead raises on transport/protocol                                                                         │
│    21     failure (refused connection, timeout, malformed packet, ...) rather than                                                                          │
│    22     returning a status code.                                                                                                                          │
│    23                                                                                                                                                       │
│    24     To keep the connection bound to a single live event loop across calls                                                                             │
│    25     (rather than opening/closing a loop -- and the connection with it -- on                                                                           │
│    26     every call), this facade starts ONE persistent background event loop and                                                                          │
│    27     runs every amqtt coroutine on it via                                                                                                              │
│    28     ``asyncio.run_coroutine_threadsafe(...).result()``, which blocks the                                                                              │
│    29     calling thread and re-raises whatever the coroutine raised.                                                                                       │
│    30                                                                                                                                                       │
│    31     ``.connect(host, port)`` returns an object with ``.rc`` set to the                                                                                │
│    32     CONNACK code amqtt reported (0 on success), or to 1 if amqtt raised a                                                                             │
│    33     connection/transport exception -- mirroring paho's use of a nonzero rc                                                                            │
│    34     for "the operation failed".                                                                                                                       │
│    35                                                                                                                                                       │
│    36     ``.publish(topic, payload)`` returns an object with ``.rc`` = 0 once                                                                              │
│    37     amqtt's publish coroutine completes without raising. This only means the                                                                          │
│    38     message was handed to amqtt for sending/queuing -- neither amqtt nor                                                                              │
│    39     paho at QoS 0 waits for a broker acknowledgement -- so it must not be                                                                             │
│    40     read as "delivered". If amqtt raises, ``.rc`` = 1 is returned instead of                                                                          │
│    41     swallowing the failure, so callers that check ``.rc`` still observe it.                                                                           │
│    42     """                                                                                                                                               │
│    43     from amqtt.client import MQTTClient  # lazy import for testability                                                                                │
│    44     from amqtt.errors import MQTTError  # lazy import for testability                                                                                 │
│    45                                                                                                                                                       │
│    46     class _Result:                                                                                                                                    │
│    47         def __init__(self, rc):                                                                                                                       │
│    48             self.rc = rc                                                                                                                              │
│    49                                                                                                                                                       │
│    50     class _SyncFacade:                                                                                                                                │
│    51         def __init__(self):                                                                                                                           │
│    52             self._loop = asyncio.new_event_loop()                                                                                                     │
│    53             threading.Thread(target=self._loop.run_forever, daemon=True).start()                                                                      │
│    54             self._client = MQTTClient()                                                                                                               │
│    55                                                                                                                                                       │
│    56         def _run(self, coro):                                                                                                                         │
│    57             return asyncio.run_coroutine_threadsafe(coro, self._loop).result()                                                                        │
│    58                                                                                                                                                       │
│    59         def connect(self, host, port):                                                                                                                │
│    60             uri = f"mqtt://{host}:{port}/"                                                                                                            │
│    61             try:                                                                                                                                      │
│    62                 rc = self._run(self._client.connect(uri))                                                                                             │
│    63             except (MQTTError, OSError, ConnectionError, asyncio.TimeoutError):                                                                       │
│    64                 return _Result(1)                                                                                                                     │
│    65             return _Result(rc if rc is not None else 0)                                                                                               │
│    66                                                                                                                                                       │
│    67         def publish(self, topic, payload):                                                                                                            │
│    68             try:                                                                                                                                      │
│    69                 self._run(self._client.publish(topic, payload))                                                                                       │
│    70             except (MQTTError, OSError, ConnectionError, asyncio.TimeoutError):                                                                       │
│    71                 return _Result(1)                                                                                                                     │
│    72             return _Result(0)                                                                                                                         │
│    73                                                                                                                                                       │
│    74         def close(self):                                                                                                                              │
│    75             try:                                                                                                                                      │
│    76                 self._run(self._client.disconnect())                                                                                                  │
│    77             except (MQTTError, OSError, ConnectionError, asyncio.TimeoutError):                                                                       │
│    78                 pass                                                                                                                                  │
│    79             self._loop.call_soon_threadsafe(self._loop.stop)                                                                                          │
│    80                                                                                                                                                       │
│    81     return _SyncFacade()                                                                                                                              │
│    82                                                                                                                                                       │
│    83                                                                                                                                                       │
│    84 def _default_client(host: str = "localhost", port: int = 1883):                                                                                       │
│    85     client = _amqtt_sync_bridge_client(host, port)                                                                                                    │
│    86     result = client.connect(host, port)                                                                                                               │
│    87     if result.rc != 0:                                                                                                                                │
│    88         raise ConnectionError(f"amqtt connect failed with rc={result.rc}")                                                                            │
│    89     return client                                                                                                                                     │
│    90                                                                                                                                                       │
