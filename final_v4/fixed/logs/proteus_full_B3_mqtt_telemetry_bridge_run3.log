│    14 class _Result:                                                                                                                                        │
│    15     """Mimics paho-mqtt's `MQTTMessageInfo` enough for callers that read `.rc`.                                                                       │
│    16                                                                                                                                                       │
│    17     paho-mqtt's `Client.publish()` returns an `MQTTMessageInfo` whose `.rc`                                                                           │
│    18     attribute is 0 on success and a nonzero `MQTT_ERR_*` code otherwise.                                                                              │
│    19     amqtt's `MQTTClient.publish()` is a coroutine that returns `None` (or,                                                                            │
│    20     for QoS >= 1, returns once the broker has acknowledged the message) and                                                                           │
│    21     raises on failure instead of returning a status code. This class is the                                                                           │
│    22     object we hand back after awaiting amqtt's publish and mapping the                                                                                │
│    23     outcome onto paho-mqtt's rc convention.                                                                                                           │
│    24     """                                                                                                                                               │
│    25                                                                                                                                                       │
│    26     def __init__(self, rc: int):                                                                                                                      │
│    27         self.rc = rc                                                                                                                                  │
│    28                                                                                                                                                       │
│    29                                                                                                                                                       │
│    30 class _axiom_mqtt_client_wrapper:                                                                                                                     │
│    31     """Adapts amqtt's async `MQTTClient` to paho-mqtt's sync connect/publish API.                                                                     │
│    32                                                                                                                                                       │
│    33     paho-mqtt's `Client` is synchronous: `.connect()` blocks until the                                                                                │
│    34     TCP/MQTT handshake completes, and `.publish()` returns immediately with                                                                           │
│    35     an `MQTTMessageInfo` carrying a `.rc` status code.                                                                                                │
│    36                                                                                                                                                       │
│    37     amqtt only exposes an async API (`await client.connect(uri)`,                                                                                     │
│    38     `await client.publish(topic, msg, qos)`), so this wrapper starts one                                                                              │
│    39     persistent background event loop (kept alive for the object's whole                                                                               │
│    40     lifetime, never a fresh loop per call) and marshals each call onto it                                                                             │
│    41     with `asyncio.run_coroutine_threadsafe(...).result()`. Keeping the loop                                                                           │
│    42     alive keeps the connection's transport valid across calls, and                                                                                    │
│    43     `.result()` re-raises whatever amqtt raised so genuine failures reach                                                                             │
│    44     the caller instead of being hidden behind a fabricated status.                                                                                    │
│    45                                                                                                                                                       │
│    46     For QoS 0, amqtt's publish returns as soon as the message is queued --                                                                            │
│    47     no delivery confirmation is available, the same as paho-mqtt's QoS 0.                                                                             │
│    48     For QoS >= 1, amqtt awaits the broker's PUBACK/PUBREC handshake before                                                                            │
│    49     returning, so a successful await really does mean the broker                                                                                      │
│    50     acknowledged the message.                                                                                                                         │
│    51     """                                                                                                                                               │
│    52                                                                                                                                                       │
│    53     def __init__(self, cfg: BridgeConfig):                                                                                                            │
│    54         from amqtt.client import MQTTClient                                                                                                           │
│    55                                                                                                                                                       │
│    56         self._loop = asyncio.new_event_loop()                                                                                                         │
│    57         threading.Thread(target=self._loop.run_forever, daemon=True).start()                                                                          │
│    58         self._client = MQTTClient(client_id=cfg.client_id)                                                                                            │
│    59         uri = f"mqtt://{cfg.host}:{cfg.port}"                                                                                                         │
│    60         self._run(self._client.connect(uri))                                                                                                          │
│    61                                                                                                                                                       │
│    62     def _run(self, coro):                                                                                                                             │
│    63         return asyncio.run_coroutine_threadsafe(coro, self._loop).result()                                                                            │
│    64                                                                                                                                                       │
│    65     def publish(self, topic, payload, qos=0):                                                                                                         │
│    66         """Publish and return a `_Result` carrying an `.rc` status code.                                                                              │
│    67                                                                                                                                                       │
│    68         amqtt's `publish()` returns `None` on success (queued for QoS 0,                                                                              │
│    69         broker-acknowledged for QoS >= 1) and raises on transport or                                                                                  │
│    70         protocol failure rather than returning a paho-style rc. We await it                                                                           │
│    71         on the persistent loop and translate: success -> rc=0.                                                                                        │
│    72                                                                                                                                                       │
│    73         amqtt does not export a stable, documented public exception class                                                                             │
│    74         for "not connected"/"broker unreachable" from `amqtt.client` on this                                                                          │
│    75         distribution (attempting to import `ClientException` or                                                                                       │
│    76         `ConnectException` from it raises `ImportError`), so rather than                                                                              │
│    77         reference a name that may not exist we catch the network-layer                                                                                │
│    78         failure modes paho-mqtt itself reports at this call site --                                                                                   │
│    79         `ConnectionError` and `OSError` (socket refusal, reset, broken pipe,                                                                          │
│    80         timeouts) -- and map them onto rc=4 (`MQTT_ERR_NO_CONN`), the same                                                                            │
│    81         code paho-mqtt returns when a publish cannot reach the broker. Any                                                                            │
│    82         other exception (e.g. a malformed topic) propagates unchanged, just                                                                           │
│    83         as paho-mqtt lets unexpected errors reach the caller.                                                                                         │
│    84         """                                                                                                                                           │
│    85         try:                                                                                                                                          │
│    86             self._run(self._client.publish(topic, payload, qos=qos))                                                                                  │
│    87         except (ConnectionError, OSError):                                                                                                            │
│    88             return _Result(4)                                                                                                                         │
│    89         return _Result(0)                                                                                                                             │
│    90                                                                                                                                                       │
│    91                                                                                                                                                       │
