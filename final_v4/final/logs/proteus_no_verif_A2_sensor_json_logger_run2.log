│    4 backend is the substitution target: `json` (stdlib) -> `ujson` (drop-in, faster).                                                                      │
│    5 Determinism (sorted keys, compact separators) is a hard requirement so that audit                                                                      │
│    6 logs are byte-reproducible.                                                                                                                            │
│    7 """                                                                                                                                                    │
│    8 import ujson                                                                                                                                           │
│    9 from typing import Iterable, Mapping                                                                                                                   │
│   10                                                                                                                                                        │
│   11 _SEPARATORS = (",", ":")                                                                                                                               │
│   12                                                                                                                                                        │
│   13                                                                                                                                                        │
│   14 def _axiom_ujson_dumps_wrapper(record, sort_keys=True):                                                                                                │
│   15     """Serialize `record` to a compact, deterministic JSON string.                                                                                     │
│   16                                                                                                                                                        │
│   17     json.dumps(record, sort_keys=True, separators=(',', ':')) produces a                                                                               │
│   18     byte-reproducible, whitespace-free JSON string with no space after                                                                                 │
│   19     ',' or ':' -- this is what the audit log format requires.                                                                                          │
│   20                                                                                                                                                        │
│   21     ujson.dumps(record, sort_keys=True) has no `separators` parameter at                                                                               │
│   22     all, so passing one raises a TypeError. Its default output is already                                                                              │
│   23     compact (no space after ',' or ':'), but to guarantee the exact same                                                                               │
│   24     byte layout regardless of ujson version behavior, we still explicitly                                                                              │
│   25     strip any stray ", " / ": " spacing that could appear, so the result                                                                               │
│   26     is guaranteed identical to the original separators=(',', ':') format.                                                                              │
│   27     """                                                                                                                                                │
│   28     encoded = ujson.dumps(record, sort_keys=sort_keys)                                                                                                 │
│   29     return encoded.replace(", ", ",").replace(": ", ":")                                                                                               │
│   30                                                                                                                                                        │
│   31                                                                                                                                                        │
