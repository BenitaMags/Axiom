lif isinstance(stmt, cst.Expr) and isinstance(stmt.value, cst.Call):\n            call = stmt.value\n            rebuild = lambda new_call: stmt.with_changes(value=new_call)\n        elif isinstance(stmt, cst.Return) and stmt.value is not None and isinstance(stmt.value, cst.Call):\n            call = stmt.value\n            rebuild = lambda new_call: stmt.with_changes(value=new_call)\n\n        if call is None:\n            return updated_node\n\n        new_call, new_stmts = self._process_call(call)\n        if not new_stmts:\n            return updated_node\n\n        new_line = updated_node.with_changes(body=[rebuild(new_call)])\n        return cst.FlattenSentinel(new_stmts + [new_line])\n\n\ndef transform(source: str) -> str:\n    try:\n        tree = cst.parse_module(source)\n    except Exception:\n        return source\n\n    try:\n        existing_names = _collect_existing_names(tree)\n        transformer = _Transformer(existing_names)\n        new_tree = tree.visit(transformer)\n        return new_tree.code\n    except Exception:\n        return source",
