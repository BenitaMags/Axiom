  "implementation": "import libcst as cst\n\n\ndef _negate(cond: cst.BaseExpression) -> cst.BaseExpression:\n    if isinstance(cond, cst.UnaryOperation) and isinstance(cond.operator, cst.Not):\n        inner = cond.expression\n        if isinstance(inner, cst.BaseParenthesizedNode) or True:\n            return inner.with_changes(\n                lpar=cond.lpar if not inner.lpar else inner.lpar,\n                rpar=cond.rpar if not inner.rpar else inner.rpar,\n            )\n\n    if isinstance(cond, cst.BooleanOperation):\n        left_neg = _negate(cond.left)\n        right_neg = _negate(cond.right)\n        if isinstance(cond.operator, cst.And):\n            new_op = cst.Or()\n        else:\n            new_op = cst.And()\n        return cst.BooleanOperation(\n            left=left_neg,\n            operator=new_op,\n            right=right_neg,\n        )\n\n    if isinstance(cond, cst.Comparison) and len(cond.comparisons) == 1:\n        target = cond.comparisons[0]\n        op = target.operator\n        new_op = None\n        if isinstance(op, cst.LessThan):\n            new_op = cst.GreaterThanEqual()\n        elif isinstance(op, cst.GreaterThanEqual):\n            new_op = cst.LessThan()\n        elif isinstance(op, cst.LessThanEqual):\n            new_op = cst.GreaterThan()\n        elif isinstance(op, cst.GreaterThan):\n            new_op = cst.LessThanEqual()\n        elif isinstance(op, cst.Equal):\n            new_op = cst.NotEqual()\n        elif isinstance(op, cst.NotEqual):\n            new_op = cst.Equal()\n        elif isinstance(op, cst.Is):\n            new_op = cst.IsNot()\n        elif isinstance(op, cst.IsNot):\n            new_op = cst.Is()\n        elif isinstance(op, cst.In):\n            new_op = cst.NotIn()\n        elif isinstance(op, cst.NotIn):\n            new_op = cst.In()\n\n        if new_op is not None:\n            new_target = target.with_changes(operator=new_op)\n            return cond.with_changes(comparisons=[new_target])\n\n    # fallback: wrap as not (atom)\n    inner = cond\n    if inner.lpar:\n        wrapped = inner\n    else:\n        wrapped = inner.with_changes(\n            lpar=[cst.LeftParen()],\n            rpar=[cst.RightParen()],\n        )\n    return cst.UnaryOperation(operator=cst.Not(), expression=wrapped)\n\n\nclass DemorganTransformer(cst.CSTTransformer):\n    def leave_If(self, original_node: cst.If, updated_node: cst.If) -> cst.BaseStatement:\n        orelse = updated_node.orelse\n\n        if orelse is None:\n            return updated_node\n\n        if isinstance(orelse, cst.Else):\n            else_body = orelse.body\n            if len(else_body.body) == 0 or len(updated_node.body.body) == 0:\n                return updated_node\n\n            new_test = _negate(updated_node.test)\n\n            new_if_body = orelse.body\n            new_else_body = updated_node.body\n\n            new_else = orelse.with_changes(body=new_else_body)\n\n            return updated_node.with_changes(\n                test=new_test,\n                body=new_if_body,\n                orelse=new_else,\n            )\n\n        return updated_node\n\n\ndef transform(source: str) -> str:\n    try:\n        tree = cst.parse_module(source)\n        new_tree = tree.visit(DemorganTransformer())\n        return new_tree.code\n    except Exception:\n        return source",
