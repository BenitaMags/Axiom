  "implementation": "\"\"\"\nindependent_assignment_swap: swap adjacent simple `NAME = EXPR` statements\nwhen it is provably safe to do so, purely syntactically.\n\"\"\"\n\nimport libcst as cst\nimport libcst.matchers as m\n\n\ndef _is_pure_expr(node: cst.BaseExpression) -> bool:\n    \"\"\"Return True if node is built only from literals, bare names, and\n    arithmetic/comparison/boolean operators reading names -- no calls,\n    attribute access, subscripts, comprehensions, lambdas, walrus, yield,\n    await, etc.\"\"\"\n\n    class Bad(Exception):\n        pass\n\n    class Checker(cst.CSTVisitor):\n        def on_visit(self, n: cst.CSTNode) -> bool:\n            if isinstance(\n                n,\n                (\n                    cst.Call,\n                    cst.Attribute,\n                    cst.Subscript,\n                    cst.ListComp,\n                    cst.SetComp,\n                    cst.DictComp,\n                    cst.GeneratorExp,\n                    cst.Lambda,\n                    cst.NamedExpr,\n                    cst.Yield,\n                    cst.Await,\n                ),\n            ):\n                raise Bad()\n            return True\n\n    try:\n        node.visit(Checker())\n    except Bad:\n        return False\n    return True\n\n\ndef _contains_name(node: cst.CSTNode, name: str) -> bool:\n    found = False\n\n    class Finder(cst.CSTVisitor):\n        def visit_Name(self, n: cst.Name) -> None:\n            nonlocal found\n            if n.value == name:\n                found = True\n\n    node.visit(Finder())\n    return found\n\n\ndef _simple_assign_target(stmt: cst.BaseStatement):\n    \"\"\"If stmt is a SimpleStatementLine containing exactly one Assign with\n    a single bare-Name target and no chained targets, return (name, expr, node).\n    Otherwise return None.\"\"\"\n    if not isinstance(stmt, cst.SimpleStatementLine):\n        return None\n    if len(stmt.body) != 1:\n        return None\n    small = stmt.body[0]\n    if not isinstance(small, cst.Assign):\n        return None\n    if len(small.targets) != 1:\n        return None\n    target_node = small.targets[0].target\n    if not isinstance(target_node, cst.Name):\n        return None\n    return target_node.value, small.value, stmt\n\n\nclass _SwapTransformer(cst.CSTTransformer):\n    def _process_body(self, body_seq):\n        new_body = list(body_seq)\n        i = 0\n        changed = False\n        while i < len(new_body) - 1:\n            s1 = new_body[i]\n            s2 = new_body[i + 1]\n            info1 = _simple_assign_target(s1)\n            info2 = _simple_assign_target(s2)\n            if info1 is not None and info2 is not None:\n                name1, expr1, node1 = info1\n                name2, expr2, node2 = info2\n                if name1 != name2:\n                    if _is_pure_expr(expr1) and _is_pure_expr(expr2):\n                        if not _contains_name(expr1, name2) and not _contains_name(\n                            expr2, name1\n                        ):\n                            new_body[i], new_body[i + 1] = node2, node1\n                            changed = True\n                            i += 2\n                            continue\n            i += 1\n        return new_body, changed\n\n    def leave_IndentedBlock(\n        self, original_node: cst.IndentedBlock, updated_node: cst.IndentedBlock\n    ) -> cst.IndentedBlock:\n        new_body, changed = self._process_body(updated_node.body)\n        if changed:\n            return updated_node.with_changes(body=new_body)\n        return updated_node\n\n    def leave_Module(\n        self, original_node: cst.Module, updated_node: cst.Module\n    ) -> cst.Module:\n        new_body, changed = self._process_body(updated_node.body)\n        if changed:\n            return updated_node.with_changes(body=new_body)\n        return updated_node\n\n\ndef transform(source: str) -> str:\n    try:\n        tree = cst.parse_module(sourc