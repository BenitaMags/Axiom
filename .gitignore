# ── Regenerable caches and datasets ──────────────────────────────────────
# pymigbench_repos is a --repo-cache: `axiom-eval run --repo-cache ./pymigbench_repos`
# re-clones what it needs. pymigbench_data comes back via
# `axiom-eval fetch-dataset ./pymigbench_data`. Both arrive as nested git
# repositories, which git records as gitlinks and refuses to commit usefully.
pymigbench_repos/
pymigbench_data/

# A git worktree of this same repository; never a subdirectory to commit.
copilot-worktrees/

